# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
*.venv

# IDEs
.idea/
.vscode/

# OS-specific
.DS_Store
Thumbs.db

# Logs and session files
*.log
conversation.txt

# Fusion Electronics exports
exports/*
